{
	"name": "nuxt-app",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "nuxt build",
		"dev": "nuxt dev --dotenv .env.local",
		"format": "bun fmt",
		"format:check": "bun fmt --check",
		"generate": "nuxt generate",
		"lint": "oxlint . && eslint --config eslint.oxlint.config.mjs .",
		"lint:eslint": "eslint .",
		"lint:eslint:fix": "eslint . --fix",
		"lint:fix": "oxlint . --fix && eslint --config eslint.oxlint.config.mjs . --fix",
		"lint:hybrid": "oxlint . && eslint --config eslint.oxlint.config.mjs .",
		"lint:hybrid:fix": "oxlint . --fix && eslint --config eslint.oxlint.config.mjs . --fix",
		"lint:oxlint": "oxlint .",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"prepare": "git config core.hooksPath .githooks"
	},
	"dependencies": {
		"@better-auth/passkey": "1.6.22",
		"@convex-dev/better-auth": "0.12.6",
		"@nuxt/eslint": "^1.17.0",
		"@nuxt/image": "^2.2.0",
		"@nuxt/ui": "^4.12.0",
		"@nuxtjs/color-mode": "^4.0.1",
		"@onmax/nuxt-better-auth": "0.1.2",
		"@tanstack/vue-table": "^8.21.3",
		"@vite-pwa/nuxt": "^1.1.1",
		"better-auth": "1.6.22",
		"convex": "^1.47.0",
		"maska": "^3.2.2",
		"nuxt": "^4.6.2",
		"nuxt-convex": "https://github.com/thunfisch987/onmax-nuxt-convex/releases/download/otaku-dashboard-convex-0.0.7-r2/nuxt-convex-0.0.7.tgz",
		"nuxt-typed-router": "4.0.10",
		"unenv": "^1.10.0",
		"vue": "^3.5.44",
		"vue-router": "^5.4.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@compodium/nuxt": "0.1.0-beta.14",
		"@iconify-json/lucide": "1.2.148",
		"@iconify-json/ph": "1.2.2",
		"@iconify-json/simple-icons": "1.2.101",
		"@nuxt/devtools": "3.4.4",
		"@nuxt/kit": "4.6.3",
		"@types/node": "26.6.6",
		"@typescript/native": "npm:typescript@7.0.2",
		"eslint": "10.13.0",
		"oxlint": "1.90.0",
		"oxlint-tsgolint": "7.0.2005",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"vue-tsc": "3.3.13"
	},
	"trustedDependencies": [
		"@parcel/watcher",
		"@tailwindcss/oxide",
		"better-sqlite3",
		"core-js",
		"esbuild",
		"sharp",
		"unrs-resolver",
		"vue-demi",
		"workerd"
	],
	"devEngines": {
		"packageManager": {
			"name": "bun",
			"version": "1.4.4",
			"onFail": "download"
		}
	}
}
