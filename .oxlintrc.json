{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"categories": {
		"correctness": "warn",
		"suspicious": "warn"
	},
	"rules": {
		"eslint/no-underscore-dangle": [
			"warn",
			{
				"allow": ["_id", "_default"]
			}
		]
	},
	"ignorePatterns": [
		".nuxt/**",
		".output/**",
		".data/**",
		".nitro/**",
		"convex/_generated/**",
		"convex/betterAuth/_generated/**",
		"**/*.vue"
	]
}
