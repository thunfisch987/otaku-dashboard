// Folder-specific settings
//
// For a full list of overridable settings, and general information on folder-specific settings,
// see the documentation: https://zed.dev/docs/configuring-zed#settings-files
{
	"file_scan_exclusions": [
		"**/.git",
		"**/.svn",
		"**/.hg",
		"**/CVS",
		"**/.DS_Store",
		"**/Thumbs.db",
		"**/.classpath",
		"**/.settings"
		// "components/ui",
	],

	"format_on_save": "on",
	"lsp": {
		"tailwindcss-language-server": {
			"settings": {
				"classAttributes": [
					"class",
					"className",
					"ngClass",
					"class:list",
					"active-class"
				]
			}
		},
		"vtsls": {
			"settings": {
				"autoUseWorkspaceTsdk": true
			}
		},
		"oxlint": {
			"initialization_options": {
				"settings": {
					"run": "onType",
					"fixKind": "safe_fix",
					"typeAware": true,
					"unusedDisableDirectives": "deny"
				}
			}
		}
	},
	"languages": {
		"CSS": {
			"format_on_save": "on",
			"formatter": {
				"external": {
					"command": "bun",
					"arguments": ["fmt", "--stdin-filepath", "{buffer_path}"]
				}
			}
		},
		"HTML": {
			"format_on_save": "on",
			"formatter": {
				"external": {
					"command": "bun",
					"arguments": ["fmt", "--stdin-filepath", "{buffer_path}"]
				}
			}
		},
		"JavaScript": {
			"format_on_save": "on",
			"formatter": [
				{
					"code_action": "source.fixAll.oxc"
				},
				{
					"external": {
						"command": "bun",
						"arguments": [
							"fmt",
							"--stdin-filepath",
							"{buffer_path}"
						]
					}
				}
			]
		},
		"JSON": {
			"format_on_save": "on",
			"formatter": {
				"external": {
					"command": "bun",
					"arguments": ["fmt", "--stdin-filepath", "{buffer_path}"]
				}
			}
		},
		"JSONC": {
			"format_on_save": "on",
			"formatter": {
				"external": {
					"command": "bun",
					"arguments": ["fmt", "--stdin-filepath", "{buffer_path}"]
				}
			}
		},
		"Markdown": {
			"format_on_save": "on",
			"formatter": {
				"external": {
					"command": "bun",
					"arguments": ["fmt", "--stdin-filepath", "{buffer_path}"]
				}
			}
		},
		"TypeScript": {
			"format_on_save": "on",
			"formatter": {
				"external": {
					"command": "bun",
					"arguments": ["fmt", "--stdin-filepath", "{buffer_path}"]
				}
			}
		},
		"TSX": {
			"format_on_save": "on",
			"formatter": {
				"external": {
					"command": "bun",
					"arguments": ["fmt", "--stdin-filepath", "{buffer_path}"]
				}
			}
		},
		"Vue.js": {
			"format_on_save": "on",
			"formatter": {
				"external": {
					"command": "bun",
					"arguments": ["fmt", "--stdin-filepath", "{buffer_path}"]
				}
			}
		},
		"YAML": {
			"format_on_save": "on",
			"formatter": {
				"external": {
					"command": "bun",
					"arguments": ["fmt", "--stdin-filepath", "{buffer_path}"]
				}
			}
		}
	}
}
